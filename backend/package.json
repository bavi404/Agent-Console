{
  "name": "agent-console-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real agent backend: bridges an LLM (Ollama or Gemini) to the Agent Console wire protocol over WebSocket.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "start:noenv": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
