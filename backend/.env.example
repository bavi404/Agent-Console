# Which LLM provider to use: "ollama" (local, no key) or "gemini" (free key)
PROVIDER=ollama

# Port the WebSocket server listens on
PORT=8787

# --- Ollama (local, no API key) ---
# Install from https://ollama.com, then: ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Gemini (free tier: https://aistudio.google.com/apikey) ---
# Only needed when PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Tool policy (checked before every tool call; all optional) ---
# Comma-separated tools to disable, e.g. wikipedia_lookup
TOOL_POLICY_DENY=
# Max tool calls per user message, overall and per tool
TOOL_POLICY_MAX_CALLS=8
TOOL_POLICY_MAX_CALLS_PER_TOOL=4
# Max size of a call's JSON arguments, in characters
TOOL_POLICY_MAX_ARG_CHARS=2000
# Comma-separated tools that need your approval in the console before each run
TOOL_POLICY_REQUIRE_APPROVAL=
# How long a call waits for Approve / Reject before it is cancelled (ms)
TOOL_POLICY_APPROVAL_TIMEOUT_MS=120000
